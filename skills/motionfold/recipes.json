    "react",
    "vue",
    "svelte",
    "solid"
  ],
  "families": {
    "surface": "A layer that opens over the page and later leaves.",
    "state": "A control or region that changes state in place.",
    "feedback": "A short confirmation or correction after an action.",
    "navigation": "A move between two views of the same level."
